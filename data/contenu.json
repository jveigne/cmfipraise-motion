 "paroles": {
  "fr": {
   "titre": "A MOI LES COEURS BRAVES",
   "auteur": "ED. MONOD",
   "parties": [
    {
     "type": "couplet",
     "lignes": [
      "A MOI les cœurs braves !",
      "A dit le Vainqueur",
      "Qui rompt les entraves",
      "Du pauvre pécheur.",
      "Noble est la carrière :",
      "Qui veut y courir,",
      "Et, sous ma bannière,",
      "Combattre et vivre ?"
     ]
    },
    {
     "type": "refrain",
     "lignes": [
      "A toi, Divin Maître,",
      "Mon cœur et mon bras :",
      "Jésus, je veux être",
      "Un de tes soldats !"
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "L'ennemi fait rage !",
      "Je sens ses fureurs ;",
      "Comme un bruit d'orage",
      "J'entends ses clameurs",
      "Quand Satan déchaîne",
      "Tous ses alliés :",
      "Mais ce flot de haine",
      "Expire à tes pieds."
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "Ma couronne est prête :",
      "Tu m'as racheté !",
      "Ma justice est faite",
      "De Ta sainteté.",
      "Ta grâce infinie",
      "Couvre mes péchés ;",
      "A Ta croix bénie",
      "Ils sont attachés."
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "Après tant de luttes,",
      "Lassés, mais vainqueurs,",
      "Relevés des chutes,",
      "Guéris des douleurs,",
      "Gardés sous ton aile,",
      "Nous aurons toujours",
      "La paix éternelle",
      "Et pourrons chanter :"
     ]
    },
    {
     "type": "refrain",
     "lignes": [
      "A Toi les couronnes",
      "De tous les élus !",
      "C'est Toi qui leur donnes",
      "Ton ciel, ô Jésus !"
     ]
    }
   ]
  },
  "en": {
   "titre": "ONWARD ! CHRISTIAN SOLDIERS,",
   "auteur": "SABINE BARING-GOULD",
   "parties": [
    {
     "type": "couplet",
     "lignes": [
      "ONWARD ! Christian soldiers,",
      "Marching as to war,",
      "With the Cross of Jesus",
      "Going on before.",
      "Christ, the Royal Master,",
      "Leads against the foe ;",
      "Forward into battle,",
      "See ! His banners go."
     ]
    },
    {
     "type": "refrain",
     "lignes": [
      "Onward ! Christian soldiers,",
      "Marching as to war,",
      "With the Cross of Jesus",
      "Going on before."
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "At the sign of triumph",
      "Satan's legions flee ;",
      "On then, Christian solders,",
      "On to victory !",
      "Hell's foundations quiver",
      "At the shout of praise ;",
      "Brothers, lift your voices,",
      "Loud your anthems raise."
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "Like a mighty army",
      "Moves the Church of God ;",
      "Brothers, we are treading",
      "Where the saints have trod.",
      "We are not divided,",
      "All one body we,",
      "One in hope, in doctrine,",
      "One in charity."
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "Crowns and thrones may perish,",
      "Kingdoms rise and wane,",
      "But the Church of Jesus",
      "Constant will remain ;",
      "Gates of hell can never",
      "'Gainst that Church prevail ;",
      "We have Christ's own promise,",
      "And that cannot fail."
     ]
    },
    {
     "type": "couplet",
     "lignes": [
      "Onward, then, ye people !",
      "Join our happy throng ;",
      "Blend with ours your voices",
      "In the triumph song ;",
      "'Glory, laud, and honour",
      "Unto Christ the King !'",
      "This, through countless ages,",
      "Men and angels sing."
     ]
    }
   ]
  }
 },
